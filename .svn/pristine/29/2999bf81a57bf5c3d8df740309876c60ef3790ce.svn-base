                                                                        <asp:FilteredTextBoxExtender ID="fteCheckAmount" runat="server" TargetControlID="txtCheckAmount" FilterType="Custom, Numbers" ValidChars=".,"></asp:FilteredTextBoxExtender>
                                                                    </td>
                                                                </tr>
