<%@ Page Language="vb" AutoEventWireup="false" MasterPageFile="~/OCS.Master" CodeBehind="PaymentPremiumRelated.aspx.vb" Inherits="Cocolife.UI.OCS.PaymentPremiumRelated"
    Title="Online Collection System (Payment : Premium Related)" %>

<%@ MasterType VirtualPath="~/OCS.Master" %>

<%@ Register Assembly="AjaxControlToolkit" Namespace="AjaxControlToolkit" TagPrefix="asp" %>

<%@ Register assembly="CrystalDecisions.Web, Version=13.0.2000.0, Culture=neutral, PublicKeyToken=692fbea5521e1304" namespace="CrystalDecisions.Web" tagprefix="CR" %>

<asp:Content ID="Content1" ContentPlaceHolderID="head" runat="server">
</asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="ContentPlaceHolder2" runat="server">
    
    <script type="text/javascript" language="javascript">

        var ModalProgress = '<%=mpeProgress.ClientID%>';
        var ModalConfirm = '<%=mpeConfirm.ClientID%>';

        var ConfirmYes = '<%=btnConfirmYes.ClientID%>';
        Sys.WebForms.PageRequestManager.getInstance().add_beginRequest(beginReq);
        Sys.WebForms.PageRequestManager.getInstance().add_endRequest(endReq);

        function beginReq(sender, args) {
            var postBackElementID = args.get_postBackElement().id;
            if (ConfirmYes == postBackElementID) {
                $find(ModalConfirm).hide();
            }
            $find(ModalProgress).show();
        }

        function endReq(sender, args) {
            $find(ModalProgress).hide();
        }

        function ClearCreditCardDetails() {
            var evt = (evt) ? evt : ((event) ? event : null);
            var node = (evt.target) ? evt.target : ((evt.srcElement) ? evt.srcElement : null);
            if ((evt.keyCode >= 48 && evt.keyCode <= 57) || (evt.keyCode >= 96 && evt.keyCode <= 105) || evt.keyCode == 8 || evt.keyCode == 46) {
                document.getElementById('<%= txtCreditCardType.ClientID%>').value = "";
                document.getElementById('<%= hdnCreditCardNumberTag.ClientID%>').value = "false";
                document.getElementById('<%= hdnCreditCardType.ClientID %>').value = "";
            }
        }

        function SelectDebitCardBankName() {
            if ($('#<%=ddlDebitCardBankName.ClientID%>').children("option:selected").val() == "OTHER") {
                $('#<%=txtDebitCardOtherBank.ClientID%>').show();
                $('#<%=lblDebitCardOtherBank.ClientID%>').html("Others:");
            } else {
                $('#<%=txtDebitCardOtherBank.ClientID%>').val('');
                $('#<%=txtDebitCardOtherBank.ClientID%>').hide();
                $('#<%=lblDebitCardOtherBank.ClientID%>').html("");
            }
        }

        function clickBtnValidateCreditCardNo() {
            $('#<%=btnValidateCreditCardNo.ClientID%>').trigger('click');
        }

        function clickVerifyGrossAmount() {
            //$('#<%=ibtnVerifyGrossAmount.ClientID%>').trigger('click');
            document.getElementById("<%=ibtnVerifyGrossAmount.ClientID%>").click();
        }

        function clickSearchPaCardID() {
            //$('#<%=ibtnSearchPaCardID.ClientID%>').trigger('click');
            document.getElementById("<%=ibtnSearchPaCardID.ClientID%>").click();
        }

        function calculateReceiptAmount(caller) {
            var GrossAmount = $('#<%=txtOPRGrossAmount.ClientID%>').val();
            var CommAmount = $('#<%=txtCommissionAmount.ClientID%>').val();
            var OprAmount = $('#<%=txtOPRAmount.ClientID%>').val();
            var GpaTag = '<%=GpaPaymentTag%>';

            if (caller == 'COMM') {
                OprAmount = GrossAmount - CommAmount;
                OprAmount = OprAmount < 0 ? 0 : OprAmount;
                $('#<%=txtOPRAmount.ClientID%>').val(OprAmount);
            } else {
                if (GpaTag) {
                    CommAmount = GrossAmount - OprAmount;
                    CommAmount = CommAmount<0?0:CommAmount;
                $('#<%=txtCommissionAmount.ClientID%>').val(CommAmount);
            }
            }
        }

    </script>

    <asp:UpdatePanel ID="upPaymentPremiumRelated" runat="server" RenderMode="Inline" UpdateMode="Conditional">
        <ContentTemplate>

            <div id="content">
                <div id="content-header-paymentpremiumrelated" class="content-header"></div>
                <div id="content-body">

                    <!-- PAYMENT DETAILS -->
                    <asp:Panel ID="pnlPaymentDetails" runat="server" CssClass="content-body-panel">
                        <div class="content-body-panel-header">Payment Details</div>
                        <div class="content-body-panel-detail">
                            <table width="100%" border="0" cellpadding="0" cellspacing="0">
                                <tr>
                                    <td class="content-body-panel-td1 lblBold11">Invoice Number</td>
                                    <td class="content-body-panel-td2">
                                        <asp:TextBox ID="txtOPRNumber" runat="server" CssClass="txtReadOnlyShort" ReadOnly="true" TabIndex="-1"></asp:TextBox>
                                        <asp:ImageButton ID="ibtnViewOPRs" runat="server" ImageUrl="~/Images/icons/view.png" CssClass="ibtn ibtnView" CausesValidation="false" ToolTip="View OPRs" />
                                    </td>
                                    <td class="content-body-panel-td3 lblBold11">Invoice Date</td>
                                    <td class="content-body-panel-td4">
                                        <asp:TextBox ID="txtOPRDate" runat="server" CssClass="txtReadOnlyShort" ReadOnly="true" TabIndex="-1"></asp:TextBox>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <asp:Panel id="pnlPaymentDetails1" runat="server">
