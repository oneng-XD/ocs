#Region "Description"
' PAGE NAME     : PRSMAS DAL  
' CREATED BY    : MPRO
' CREATED DATE  : 04/24/2013
' UPDATE LOGS [modified by | modified date | updates]
' ------------------------------------------------------------------------------- 
' 
' ------------------------------------------------------------------------------- 
#End Region

#Region "Imports"
Imports System.Data.OracleClient
Imports bllConn = Cocolife.BLL.Common.Database.BCollectionWeb
Imports cDataType = Cocolife.Utility.Common.DataType
Imports dalConstant = Cocolife.DAL.OCS.DConstant
#End Region

Namespace Person

    Public Class DPrsMas

#Region "Variables"

#End Region

#Region "Single Point Functions"

#End Region

#Region "Data Retrieval"

        Public Function GetPrsMas(ByVal pPrsPID As Long) As OracleDataReader

            Dim oraCmd As New OracleCommand(dalConstant._spCISGetPrsmas)
            Dim OraDR As OracleDataReader = Nothing

            Try

                With oraCmd
                    .CommandType = CommandType.StoredProcedure
                    .Connection = bllConn.Instance.Connection
                    If bllConn.Instance.Transaction IsNot Nothing Then .Transaction = bllConn.Instance.Transaction

                    With .Parameters
                        .Add(New OracleParameter("pPrsPID", OracleType.Number)).Value = pPrsPID
                        .Add(New OracleParameter("rsOut", OracleType.Cursor)).Direction = ParameterDirection.Output
                    End With

                    OraDR = .ExecuteReader
                End With

                Return OraDR

            Catch ex As Exception
                Throw
            Finally
                oraCmd.Dispose()
            End Try

        End Function

        Public Function GetPrsPID(ByVal pPrsNme As String, ByVal pPrsSex As String, ByVal pPrsDOB As date) As Long

            Dim OraCmd As New OracleCommand(dalConstant._sfCISGetPrspid)
            Dim OraDR As OracleDataReader = Nothing
            Dim lngPrsPID As Long = 0

            Try

                With OraCmd
                    .CommandType = CommandType.StoredProcedure
                    .Connection = bllConn.Instance.Connection
                    If bllConn.Instance.Transaction IsNot Nothing Then .Transaction = bllConn.Instance.Transaction

                    With .Parameters
                        .Add(New OracleParameter("pPrsNme", OracleType.VarChar)).Value = pPrsNme
                        .Add(New OracleParameter("pPrsSex", OracleType.VarChar)).Value = pPrsSex
                        .Add(New OracleParameter("pPrsDOB", OracleType.DateTime)).Value = pPrsDOB
                        .Add(New OracleParameter("vPrsPID", OracleType.Number)).Direction = ParameterDirection.ReturnValue
                    End With

                    OraDR = .ExecuteReader
                    lngPrsPID = .Parameters("vPrsPID").Value
                    .Parameters.Clear()
                End With

                Return lngPrsPID

            Catch ex As Exception
                Throw
            Finally
                OraCmd.Dispose()
            End Try

        End Function

        ' ------------------------------------------------------------------------------- 

        Public Function SearchPrsMas(ByVal pPrsPID As Long, ByVal pPrsNme As String, ByVal pSexVal As Integer) As DataTable

            Dim oraCmd As New OracleCommand(dalConstant._spOCSSearchPrsmas)
            Dim oraDA As OracleDataAdapter = Nothing
            Dim ds As New DataSet

            Try

                With oraCmd
                    .CommandType = CommandType.StoredProcedure
                    .Connection = bllConn.Instance.Connection
                    If bllConn.Instance.Transaction IsNot Nothing Then .Transaction = bllConn.Instance.Transaction

                    With .Parameters
                        .Add(New OracleParameter("pPrsPID", OracleType.Number)).Value = pPrsPID
                        .Add(New OracleParameter("pPrsNme", OracleType.VarChar)).Value = pPrsNme
                        .Add(New OracleParameter("pSexVal", OracleType.Number)).Value = pSexVal
                        .Add(New OracleParameter("rsOut", OracleType.Cursor)).Direction = ParameterDirection.Output
                    End With

                    oraDA = New OracleDataAdapter(oraCmd)
                    oraDA.Fill(ds, "dtSearchPRSMAS")
                End With

                Return ds.Tables("dtSearchPRSMAS")

            Catch ex As Exception
                Throw
            Finally
                oraCmd.Dispose()
            End Try

        End Function

#End Region

#Region "Transactions"

        Public Function AlterPrsMas(ByVal pList As IList, ByVal pSecoID As String, ByVal pAction As String, ByRef pOraConn As OracleConnection, ByRef pOraTrans As OracleTransaction) As List(Of String)

            Dim OraCmd As New OracleCommand(dalConstant._spCISAlterPrsmas)
            Dim OraDR As OracleDataReader = Nothing
            Dim strItem As String = String.Empty
            Dim lstStrItem As New List(Of String)

            Try

                With OraCmd
                    .CommandType = CommandType.StoredProcedure
                    .Connection = pOraConn
                    .Transaction = pOraTrans

                    For Each lstItem In pList

                        With .Parameters
                            .Add(New OracleParameter("pPrsPID", OracleType.Number)).Value = lstItem.PrsPID                                  ' 1
                            .Add(New OracleParameter("pPrsNme", OracleType.VarChar)).Value = lstItem.PrsNme                                 ' 2
                            .Add(New OracleParameter("pPrsTit", OracleType.VarChar)).Value = cDataType.fString.IfDBNull(lstItem.PrsTit)     ' 3
                            .Add(New OracleParameter("pPrsSex", OracleType.VarChar)).Value = cDataType.fString.IfDBNull(lstItem.PrsSex)     ' 4
                            .Add(New OracleParameter("pPrsSoc", OracleType.VarChar)).Value = cDataType.fString.IfDBNull(lstItem.PrsSoc)     ' 5
                            .Add(New OracleParameter("pPrsPlc", OracleType.VarChar)).Value = cDataType.fString.IfDBNull(lstItem.PrsPlc)     ' 6
                            .Add(New OracleParameter("pPrsDOB", OracleType.DateTime)).Value = cDataType.fDate.IfDBNull(lstItem.PrsDOB)      ' 7 
                            .Add(New OracleParameter("pPrsEml", OracleType.VarChar)).Value = cDataType.fString.IfDBNull(lstItem.PrsEml)     ' 8
                            .Add(New OracleParameter("pPrsLnm", OracleType.VarChar)).Value = cDataType.fString.IfDBNull(lstItem.PrsLnm)     ' 9
                            .Add(New OracleParameter("pPrsFnm", OracleType.VarChar)).Value = cDataType.fString.IfDBNull(lstItem.PrsFnm)     ' 10
                            .Add(New OracleParameter("pPrsMnm", OracleType.VarChar)).Value = cDataType.fString.IfDBNull(lstItem.PrsMnm)     ' 11
                            .Add(New OracleParameter("pPrsNsf", OracleType.VarChar)).Value = cDataType.fString.IfDBNull(lstItem.PrsNsf)     ' 12
                            .Add(New OracleParameter("pPrsIDx", OracleType.VarChar)).Value = cDataType.fString.IfDBNull(lstItem.PrsIdx)     ' 13
                            .Add(New OracleParameter("pPrsCel", OracleType.VarChar)).Value = cDataType.fString.IfDBNull(lstItem.PrsCel)     ' 14
                            .Add(New OracleParameter("pPrsPag", OracleType.VarChar)).Value = cDataType.fString.IfDBNull(lstItem.PrsPag)     ' 15
                            .Add(New OracleParameter("pDivNum", OracleType.VarChar)).Value = cDataType.fString.IfDBNull(lstItem.DivNum)     ' 16
                            .Add(New OracleParameter("pStaNum", OracleType.VarChar)).Value = cDataType.fString.IfDBNull(lstItem.StaNum)     ' 17
                            .Add(New OracleParameter("pSecoID", OracleType.VarChar)).Value = pSecoID                                        ' 18
                            .Add(New OracleParameter("pAction", OracleType.VarChar)).Value = pAction                                        ' 19
                            .Add(New OracleParameter("rsOut", OracleType.Cursor)).Direction = ParameterDirection.Output                     ' 20
                        End With

                        OraDR = .ExecuteReader
                        With OraDR.Read()
                            strItem = OraDR.Item(0).ToString
                            If Left(strItem, 2) <> "OK" Then
                                Throw New Exception(strItem)
                            Else
                                lstStrItem.Add(Mid(strItem, 4))
                            End If
                        End With

                        .Parameters.Clear()

                    Next

                End With

                Return lstStrItem

            Catch ex As Exception
                Throw
            Finally
                OraCmd.Dispose()
                If Not IsNothing(OraDR) Then
                    OraDR.Dispose()
                End If
            End Try

        End Function

#End Region

    End Class

End Namespace

