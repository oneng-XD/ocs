#Region "Data Retrieval"

        Property CardSite As String

        Public Sub SearchPayslipCode(ByVal pPayslipCode As String) Implements IHMOPayslip.SearchPayslipCode
            Dim objDal As New dalReference.DHMOPayslip
            Dim dtLocal As DataTable

            Try
                If Boolean.Parse(If(ConfigurationManager.AppSettings("Newgen-HMO"), "false")) Then
                    dtLocal = objDal.SearchPayslipCodeNGI(pPayslipCode)
                Else
                    dtLocal = objDal.SearchPayslipCode(pPayslipCode)
                End If
                dtLocal = objDal.SearchPayslipCodeNGI(pPayslipCode)
                For Each dr As DataRow In dtLocal.Rows
                    CollHdrId = cDataType.fLong.IfNull(dr.Item("colhdr_id"))
                    HeaderId = cDataType.fLong.IfNull(dr.Item("header_id"))
                    RemitCode = cDataType.fString.IfNull(dr.Item("remit_code"))
                    RemitAmount = cDataType.fDecimal.IfNull(dr.Item("remit_amount"))
                    PayorTypeId = cDataType.fInteger.IfNull(dr.Item("payor_type_id"))
                    PayorId = cDataType.fString.IfNull(dr.Item("payor_id"))
                    PayorCode = cDataType.fString.IfNull(dr.Item("payor_code"))
                    AprNumber = cDataType.fString.IfNull(dr.Item("apr_number"))
                    CheckNumber = cDataType.fString.IfNull(dr.Item("check_number"))
                    PaymentForm = cDataType.fString.IfNull(dr.Item("payment_form"))
                    StatusId = cDataType.fInteger.IfNull(dr.Item("status_id"))
                    PostBy = cDataType.fString.IfNull(dr.Item("post_by"))
                    PostDate = cDataType.fDate.IfNull(dr.Item("post_date"))
                    LastUpdate = cDataType.fDate.IfNull(dr.Item("last_update"))
                    LastUpdateBy = cDataType.fString.IfNull(dr.Item("last_update_by"))
                    Companyname = cDataType.fString.IfNull(dr.Item("companyname"))
                    PayorName = cDataType.fString.IfNull(dr.Item("payor_name"))
                    GrossPayment = cDataType.fDecimal.IfNull(dr.Item("gross_payment"))
                    TotDeductibles = cDataType.fDecimal.IfNull(dr.Item("tot_deductibles"))
                    NetPayment = cDataType.fDecimal.IfNull(dr.Item("net_payment"))
                    Particulars = cDataType.fString.IfNull(dr.Item("particulars"))
                    ChargeTo = cDataType.fString.IfNull(dr.Item("charge_to"))
                    PaymentMode = cDataType.fString.IfNull(dr.Item("payment_mode"))
                    UserName = cDataType.fString.IfNull(dr.Item("user_name"))
                    Ewt = cDataType.fDecimal.IfNull(dr.Item("ewt"))
                    PolicyNumber = cDataType.fString.IfNull(dr.Item("policy_number"))
                    PayslipCode = cDataType.fString.IfNull(dr.Item("payslip_code"))
                    OrNumber = cDataType.fString.IfNull(dr.Item("or_number"))
                    PaymentType = cDataType.fInteger.IfNull(dr.Item("payment_type"))
                    CheckDate = cDataType.fDate.IfNull(dr.Item("check_date"))
                    IssuingBank = cDataType.fString.IfNull(dr.Item("issuing_bank"))
                    'IssuingBranch = cDataType.fString.IfNull(dr.Item("issuing_branch")) 'commented by junie  this throws error idk why
                    Income = cDataType.fDecimal.IfNull(dr.Item("income"))
                    VatableAmt = cDataType.fDecimal.IfNull(dr.Item("vatable_amt"))
                    VatExempt = cDataType.fDecimal.IfNull(dr.Item("vat_exempt"))
                    VatAmount = cDataType.fDecimal.IfNull(dr.Item("vat_amount"))
                    IssuedBy = cDataType.fString.IfNull(dr.Item("issued_by"))
                    AprDate = cDataType.fDate.IfNull(dr.Item("apr_date"))
                    'added by junie
                    PayorTin = cDataType.fString.IfNull(dr.Item("tin_id"))
                    PayorAddress = cDataType.fString.IfNull(dr.Item("address"))

                    IsRecordExist = True
                    Exit For

                Next

            Catch ex As Exception
                Throw
            End Try
        End Sub

#End Region

#Region "Transactions"
        Public Function Alter(ByVal pPayslipCode As String, ByVal pReceiptNo As String, ByVal pReceiptDate As String, ByRef pConn As Object, ByRef pTrans As Object) As String

            Try
                Dim objDAL As New dalReference.DHMOPayslip
                objDAL.Alter(pPayslipCode, pReceiptNo, pReceiptDate, pConn, pTrans)
                Return objDAL.Reference
            Catch ex As Exception
                Throw
            End Try

        End Function
#End Region

    End Class

