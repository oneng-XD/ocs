        Get
            Return cDataType.fString.IfNull(ddlPayCurrency.Text)
        End Get
        Set(value As String)
            If value = "USD" Then
                ddlPayCurrency.Text = value
            Else
                ddlPayCurrency.Text = "PHP"
            End If
        End Set
