#Region "Imports"
Imports System.Data.OracleClient
Imports bllConn = Cocolife.BLL.Common.Database.BCollectionWeb
'Imports bllConn = Cocolife.BLL.Common.Database.BCisLife
Imports cDataType = Cocolife.Utility.Common.DataType
Imports eDBAction = Cocolife.Utility.Common.Enums.eDBAction
Imports dConstant = Cocolife.DAL.OCS.DConstant
#End Region

Namespace Staging

    Public Class DNewgenLifePayment

#Region "Variables"
        Private mReference As Object = Nothing
#End Region

#Region "Property"

        Property Reference As Object
            Get
                Return mReference
            End Get
            Set(value As Object)
                mReference = value
            End Set
        End Property

#End Region

#Region "Single Point Functions"

#End Region

#Region "Data Retrieval"

#End Region

#Region "Transactions"

        Public Sub NewgenPayment(ByVal pObject As Object, ByVal pAction As String, ByRef pOraConn As OracleConnection, ByRef pOraTrans As OracleTransaction)

            Dim oraCmd As New OracleCommand(DConstant._spNewgenPayment)
            Dim oraDR As OracleDataReader = Nothing

            Try

                With oraCmd
                    .CommandType = CommandType.StoredProcedure
                    .Connection = pOraConn
                    .Transaction = pOraTrans

                    With .Parameters
                        .Add(New OracleParameter("pORNo", OracleType.VarChar)).Value = pObject.ORNo                                          '1
                        .Add(New OracleParameter("pDateOfReceipt", OracleType.VarChar)).Value = pObject.DateOfReceipt                        '2
                        .Add(New OracleParameter("pApplicationNo", OracleType.VarChar)).Value = pObject.ApplicationNo                        '3
                        .Add(New OracleParameter("pPolicyNo", OracleType.VarChar)).Value = pObject.PolicyNo                                  '4
                        .Add(New OracleParameter("pPayorName", OracleType.VarChar)).Value = pObject.PayorName                                '5
                        .Add(New OracleParameter("pAPR", OracleType.VarChar)).Value = pObject.APR                                            '6
                        .Add(New OracleParameter("pAPRDate", OracleType.VarChar)).Value = pObject.APRDate                                    '7
                        .Add(New OracleParameter("pCurrency", OracleType.VarChar)).Value = pObject.Currency                                  '8
                        .Add(New OracleParameter("pTotalAmount", OracleType.VarChar)).Value = pObject.TotalAmount                            '9
                        .Add(New OracleParameter("pBusinessType", OracleType.VarChar)).Value = pObject.BusinessType                          '10
                        .Add(New OracleParameter("pBillNo", OracleType.VarChar)).Value = pObject.BillNo                                      '11
                        .Add(New OracleParameter("pRetainedAmount", OracleType.VarChar)).Value = pObject.RetainedAmount                      '12
                        .Add(New OracleParameter("pPaymentStatus", OracleType.VarChar)).Value = pObject.PaymentStatus                        '13
                        .Add(New OracleParameter("pRemarks", OracleType.VarChar)).Value = pObject.Remarks                                    '14
                        .Add(New OracleParameter("pParticularsJSON", OracleType.VarChar)).Value = pObject.ParticularsJSON                    '15
                        .Add(New OracleParameter("pPaymentModeJSON", OracleType.VarChar)).Value = pObject.PaymentModeJSON                    '16
                        .Add(New OracleParameter("rsOut", OracleType.Cursor)).Direction = ParameterDirection.Output                         '20
                    End With

                    oraDR = .ExecuteReader
                    With oraDR
                        Reference = 0
                        While .Read

                            Dim strItem = oraDR.Item(0).ToString
                            If Left(strItem, 2) <> "OK" Then
                                Throw New Exception(strItem)
                            Else
                                Reference = Mid(strItem, 4)
                            End If

                            'If eDBAction.isSuccessful(.Item("message")) Then
                            '    Reference = cDataType.fLong.getReference(.Item("message"))
                            'Else
                            '    Throw New Exception(.Item("message"))
                            'End If
                        End While
                    End With

                End With

            Catch ex As Exception
                Throw
            Finally
                oraCmd.Dispose()
                If Not IsNothing(oraDR) Then
                    oraDR.Dispose()
                End If
            End Try

        End Sub

        Public Sub NewgenUpdatePayment(ByVal pOPRNo As String, ByVal pChequeNo As String, ByVal pPaymentStatus As String, pChequeClearanceStatus As String, ByRef pOraConn As OracleConnection, ByRef pOraTrans As OracleTransaction)

            Dim oraCmd As New OracleCommand(DConstant._spNewgenUpdatePayment)
            Dim oraDR As OracleDataReader = Nothing

            Try

                With oraCmd
                    .CommandType = CommandType.StoredProcedure
                    .Connection = pOraConn
                    .Transaction = pOraTrans

                    With .Parameters
                        .Add(New OracleParameter("pORNo", OracleType.VarChar)).Value = pOPRNo
                        .Add(New OracleParameter("pChequeNo", OracleType.VarChar)).Value = pChequeNo
                        .Add(New OracleParameter("pPaymentStatus", OracleType.VarChar)).Value = pPaymentStatus
                        .Add(New OracleParameter("pChequeClearanceStatus", OracleType.VarChar)).Value = pChequeClearanceStatus
                        .Add(New OracleParameter("rsOut", OracleType.Cursor)).Direction = ParameterDirection.Output
                    End With

                    oraDR = .ExecuteReader
                    With oraDR
                        Reference = 0
                        While .Read

                            Dim strItem = oraDR.Item(0).ToString
                            If Left(strItem, 2) <> "OK" Then
                                Throw New Exception(strItem)
                            Else
                                Reference = Mid(strItem, 4)
                            End If

                            'If eDBAction.isSuccessful(.Item("message")) Then
                            '    Reference = cDataType.fLong.getReference(.Item("message"))
                            'Else
                            '    Throw New Exception(.Item("message"))
                            'End If
                        End While
                    End With

                End With

            Catch ex As Exception
                Throw
            Finally
                oraCmd.Dispose()
                If Not IsNothing(oraDR) Then
                    oraDR.Dispose()
                End If
            End Try

        End Sub

#End Region

    End Class

End Namespace

