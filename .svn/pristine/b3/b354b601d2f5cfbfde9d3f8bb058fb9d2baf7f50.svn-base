                ByVal pDiscount As Decimal, ByVal pDiscountIdNo As String, ByVal pAckReceiptRemarks As String, ByVal pAckReceiptOtherInfo As String, ByVal pSalesInvoiceNumber As Long,
                ByVal pAckReceiptNumber As Long, ByVal pInvoiceDate As Date, ByVal pARDate As Date, ByVal pARPrintStatus As String, ByVal pARPrintedBy As String,
                ByVal pSiteCode As Long, ByVal pParticulars As String, ByVal pPaymentTerm As String, ByVal pNextDueDate As Date, ByVal pAgentName As String,
                ByVal pAgentCode As String, ByVal pCommissionAmount As Decimal)
            AckReceiptID = pAckReceiptID
            BillReferenceNo = pBillReferenceNo
            PayorName = pPayorName
            PayorAddress = pPayorAddress
            PayorTIN = pPayorTIN
            InsuredClientName = pInsuredClientName
