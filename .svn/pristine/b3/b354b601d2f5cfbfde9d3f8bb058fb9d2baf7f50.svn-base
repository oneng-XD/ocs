#Region "Data Retrieval"

        Public Sub LoadNewAckReceipt(ByVal pSiteId As Long, ByVal pUserId As Long, Optional ByRef pConn As Object = Nothing, Optional ByRef pTrans As Object = Nothing) Implements IAckReceipt.LoadNewAckReceipt
            Dim objDal As New dalReference.DSiteDetails
            Dim mLastDocNo As String

            Try
                mLastDocNo = objDal.GetLastAckReceipt(pSiteId, pUserId, pConn, pTrans)

                If IsNewAckReceiptAllowed(mLastDocNo) Then
                    ARDate = Now
                End If

            Catch ex As Exception
                Throw
            End Try

        End Sub

        Public Function LoadViewAR(ByVal pPrspid As Long, ByVal pDocNumber As Long, ByVal pType As Integer) As DataTable Implements IAckReceipt.LoadViewAR

            Dim objDAL As New dalStaging.DAckReceipt
            Dim dtLocal As DataTable

            Try
                dtLocal = objDAL.GetDocList(pPrspid, pDocNumber, pType)

                Return dtLocal
            Catch ex As Exception
                Throw
            End Try
        End Function

        Public Function LoadViewAR(ByVal pPrspid As Long, Optional ByVal pStartDate As Date? = Nothing, Optional ByVal pEndDate As Date? = Nothing) As DataTable Implements IAckReceipt.LoadViewAR

            Dim objDAL As New dalStaging.DAckReceipt
            Dim dtLocal As DataTable

            Try

                dtLocal = objDAL.GetDocList(pPrspid, pStartDate, pEndDate)

                Return dtLocal
            Catch ex As Exception
                Throw
            End Try
        End Function

        Public Function IsNewAckReceiptAllowed(ByVal pNextDocNumber As String) As Boolean Implements IAckReceipt.IsNewAckReceiptAllowed
            Dim mDocumentDetails() As String
            Try
                mDocumentDetails = Split(pNextDocNumber, "|")

                If mDocumentDetails(0) = String.Empty Then
                    Return True
                End If

                If mDocumentDetails(1) = "READY" Or mDocumentDetails(1) = "POSTED" Then
                    Throw New ArgumentException("Please print previous document.")
                Else
                    Return True
                End If
            Catch ex As Exception
                Throw
            End Try

            Return False
        End Function

        Public Sub LoadAckReceipt(ByVal pDocNo As Long, pUserID As Long) Implements IAckReceipt.SearchAckReceipt
            Dim objDalAR As New dalStaging.DAckReceipt
            Dim objDalARPay As New dalStaging.DARPayDetails
            Dim objDalSI As New dalReference.DSalesInvoice

            Dim dtAckReceipt As DataTable

            Try
                dtAckReceipt = objDalAR.SearchAckReceipt(pDocNo)
                dtARPayDetails = objDalARPay.GetARPayDetails(pDocNo, pUserID)
                For Each dr As DataRow In dtAckReceipt.Rows
                    AckReceiptID = cDataType.fLong.IfNull(dr.Item("ID"))
                    BillReferenceNo = cDataType.fString.IfNull(dr.Item("BILL_REFERENCE_NO"))
                    PayorName = cDataType.fString.IfNull(dr.Item("PAYOR"))
                    PayorAddress = cDataType.fString.IfNull(dr.Item("ADDRESS"))
                    PayorTIN = cDataType.fString.IfNull(dr.Item("TIN"))
                    InsuredClientName = cDataType.fString.IfNull(dr.Item("INSURED_CLIENT_NAME"))
                    PolicyNumber = cDataType.fString.IfNull(dr.Item("POLICY_NUMBER"))
                    InvoiceCovFrom = cDataType.fDate.IfNull(dr.Item("INVOICE_COV_FROM"))
                    InvoiceCovTo = cDataType.fDate.IfNull(dr.Item("INVOICE_COV_TO"))
                    InvoiceCurrency = cDataType.fString.IfNull(dr.Item("INVOICE_CURRENCY"))
                    PayAmount = cDataType.fDecimal.IfNull(dr.Item("TOTAL_AMOUNT"))
                    PayCurrency = cDataType.fDecimal.IfNull(dr.Item("PAY_CURRENCY"))
                    TotalSales = cDataType.fDecimal.IfNull(dr.Item("TOTAL_SALES"))
                    WitholdingTax = cDataType.fDecimal.IfNull(dr.Item("WITHHOLDING_TAX"))
                    NetOfWitholdingTax = cDataType.fDecimal.IfNull(dr.Item("NET_WITHHOLDING_TAX"))
                    Discount = cDataType.fDecimal.IfNull(dr.Item("DISCOUNT"))
                    DiscountIdNo = cDataType.fString.IfNull(dr.Item("DISCOUNT_ID"))
                    CommissionAmount = cDataType.fDecimal.IfNull(dr.Item("DEDUCTION_AMOUNT"))
                    AckReceiptRemarks = cDataType.fString.IfNull(dr.Item("AR_REMARKS"))
                    AckReceiptOtherInfo = cDataType.fString.IfNull(dr.Item("AR_OTHER_INFO"))
                    InvoiceNumber = cDataType.fLong.IfNull(dr.Item("SALES_INVOICE_NO"))
                    InvoiceDate = cDataType.fDate.IfNull(dr.Item("SALES_INVOICE_DATE"))
                    AckReceiptNumber = cDataType.fLong.IfNull(dr.Item("AR_NO"))
                    ARDate = cDataType.fDate.IfNull(dr.Item("AR_DATE"))
                    'SIPrintStatus = cDataType.fString.IfNull(dr.Item("SI_PRINT_STATUS"))
                    ARPrintStatus = cDataType.fString.IfNull(dr.Item("STATUS"))
                    UploadDate = cDataType.fDate.IfNull(dr.Item("POSTED_DATE"))
                    SiteCode = cDataType.fLong.IfNull(dr.Item("SITE_CODE"))
                    ARPrintedBy = cDataType.fLong.IfNull(dr.Item("AR_PRINTED_BY"))
                    Particulars = cDataType.fString.IfNull(dr.Item("PARTICULARS"))

                    IsRecordExist = True
                    Exit For
                Next
                If IsRecordExist Then dtSIDetails = objDalSI.SearchSIDetails(BillReferenceNo)

            Catch ex As Exception
                Throw
            End Try
        End Sub

#End Region

#Region "Transactions"
        Public Function Alter(ByVal pAction As String, ByRef pConn As Object, ByRef pTrans As Object) As Long

            Try
                Dim objDAL As New dalStaging.DAckReceipt
                objDAL.AlterAckReceipt(Me, pAction, pConn, pTrans)
                Return objDAL.Reference
            Catch ex As Exception
                Throw
            End Try
        End Function
#End Region

    End Class

