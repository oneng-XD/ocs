                                                <tr>
                                                    <td class="lblBold11">Non VAT Amount</td>
                                                    <td>
                                                        <asp:TextBox ID="txtNonVAT" runat="server" CssClass="txtInputShortNumber" MaxLength="14"></asp:TextBox>
                                                        <asp:FilteredTextBoxExtender ID="fteNonVAT" runat="server"  TargetControlID="txtNonVAT" FilterType="Custom, Numbers" ValidChars=".,"></asp:FilteredTextBoxExtender>

                                                    </td>
                                                    <td></td>
                                                    <td></td>
                                                </tr>
                                                <tr>
                                                    <td colspan="100%">
                                                        <hr />
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td class="lblBold11">Total Sales</td>
                                                    <td>
                                                        <asp:TextBox ID="txtTotalSales" runat="server" CssClass="txtInputShortNumber" MaxLength="14" ></asp:TextBox>
                                                        <asp:FilteredTextBoxExtender ID="fteTotalSales" runat="server"  TargetControlID="txtTotalSales" FilterType="Custom, Numbers" ValidChars=".,"></asp:FilteredTextBoxExtender>
                                                    </td>
                                                    <td></td>
                                                    <td></td>
                                                </tr>
                                                <tr>
                                                    <td class="lblBold11">Less: Withholding Tax</td>
                                                    <td>
                                                        <asp:TextBox ID="txtWitholdingTax" runat="server" CssClass="txtInputShortNumber" MaxLength="14"></asp:TextBox>
                                                        <asp:FilteredTextBoxExtender ID="fteWitholdingTax" runat="server"  TargetControlID="txtWitholdingTax" FilterType="Custom, Numbers" ValidChars=".,"></asp:FilteredTextBoxExtender>
                                                    </td>
                                                    <td></td>
                                                    <td></td>
                                                </tr>
                                                <tr>
                                                    <td class="lblBold11">Amount Net of WTax</td>
                                                    <td>
                                                        <asp:TextBox ID="txtNetOfWitholdingTax" runat="server" CssClass="txtInputShortNumber" ></asp:TextBox>
                                                        <asp:FilteredTextBoxExtender ID="fteNetOfWitholdingTax" runat="server"  TargetControlID="txtNetOfWitholdingTax" FilterType="Custom, Numbers" ValidChars=".,"></asp:FilteredTextBoxExtender>
                                                    </td>
                                                    <td></td>
                                                </tr>
                                                <tr>
                                                    <td class="lblBold11">Less: Discount</td>
                                                    <td>
                                                        <asp:TextBox ID="txtDiscount" runat="server" CssClass="txtInputShortNumber" MaxLength="14"></asp:TextBox>
                                                        <asp:FilteredTextBoxExtender ID="fteDiscount" runat="server"  TargetControlID="txtDiscount" FilterType="Custom, Numbers" ValidChars=".,"></asp:FilteredTextBoxExtender>

                                                    </td>
                                                    <td></td>
                                                    <td></td>
                                                </tr>
                                                <tr>
                                                    <td class="lblBold11">Discount ID</td>
                                                    <td>
                                                        <asp:TextBox ID="txtDiscountIdNo" runat="server" CssClass="txtInputShort" ></asp:TextBox>
                                                    </td>
                                                    <td></td>
                                                </tr>
                                            </table>
                                        </div>
                                    </asp:Panel>
                                </Content>
                            </asp:AccordionPane>
                        </Panes>
                    </asp:Accordion>
                    <br />
                    <br />

                    <!-- TRANSACTIONS -->
                    <asp:Panel ID="pnlTransactions" runat="server" CssClass="panel-button">
                        <asp:Button ID="btnDMCMAddNew" runat="server" Text="New Memo" CssClass="btnShort" />
                        <asp:Button ID="btnDMCMPreview" runat="server" Text="Preview Memo" CssClass="btnShort" Visible ="false" Enabled="false"/>
                        <asp:Button ID="btnDMCMSend" runat="server" Text="Send For Approval" CssClass="btnShort" Enabled="false" />
                        <asp:Button ID="btnDMCMSave" runat="server" Text="Save Memo" CssClass="btnShort" Enabled="false" OnClientClick="return IsSaveValid();"  />
                        <asp:Button ID="btnDMCMPrint" runat="server" Text="Print Memo" CssClass="btnShort" Enabled="false"  />
                        <asp:Button ID="btnDMCMCancel" runat="server" Text="Cancel" CssClass="btnShort" Enabled="false" OnClientClick="return ConfirmCancel();"/>
                        <asp:Button ID="btnCancel" runat="server" Text="Clear" CssClass="btnShort"/>
                    </asp:Panel>
                    <!-- HIDDEN -->
                    <asp:Panel ID="pnlHiddenFields" runat="server" CssClass="panel-hidden">
