                                            <asp:TextBox ID="txtOfficeName" runat="server" CssClass="txtReadOnlyLong2" ReadOnly="true" MaxLength="60"></asp:TextBox>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="lblBold11">Head / Branch Office Address</td>
                                        <td colspan="3">
