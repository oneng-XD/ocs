<%@ Page Language="vb" AutoEventWireup="false" MasterPageFile="~/OCS.Master" CodeBehind="PaymentDebitCreditMemo.aspx.vb" Inherits="Cocolife.UI.OCS.PaymentDebitCreditMemo"
    Title="Online Collection System (Payment : Debit Credit Memo)" %>

<%@ MasterType VirtualPath="~/OCS.Master" %>

<%@ Register Assembly="AjaxControlToolkit" Namespace="AjaxControlToolkit" TagPrefix="asp" %>

<%@ Register assembly="CrystalDecisions.Web, Version=13.0.2000.0, Culture=neutral, PublicKeyToken=692fbea5521e1304" namespace="CrystalDecisions.Web" tagprefix="CR" %>


<asp:Content ID="Content1" ContentPlaceHolderID="head" runat="server">
</asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="ContentPlaceHolder2" runat="server">
    <script type="text/javascript" language="javascript">

        var ModalProgress = '<%=mpeProgress.ClientID%>';
        var ModalConfirm = '<%=mpeConfirm.ClientID%>';
        var ModalMessage = '<%=mpeMessage.ClientID%>';
        var ModalViewDMCMs = '<%=mpeViewDMCMs.ClientID%>';
        var ModalViewSIs = '<%=mpeViewSIs.ClientID%>';
        var txtInvoiceNumber = '<%=txtInvoiceNumber.ClientID%>';

        var ConfirmYes = '<%=btnConfirmYes.ClientID%>';

        Sys.WebForms.PageRequestManager.getInstance().add_beginRequest(beginReq);
        Sys.WebForms.PageRequestManager.getInstance().add_endRequest(endReq);

        function beginReq(sender, args) {
            var postBackElementID = args.get_postBackElement().id;
            if (ConfirmYes == postBackElementID) {
                $find(ModalConfirm).hide();
            }
            $find(ModalProgress).show();
        }

        function endReq(sender, args) {
            $find(ModalProgress).hide();
        }
        
      function ViewDMCMs() {
          $find(ModalViewDMCMs).show();
          return false;
      }

      function ViewSIs() {
          var today = new Date();
          var priorDate = new Date(new Date().setDate(today.getDate() - 30));

          if (document.getElementById('<%=txtInvoiceNumber.ClientID%>').value == "") {
                document.getElementById('<%=txtViewSINumber.ClientID%>').value = document.getElementById('<%=txtInvoiceNumber.ClientID%>').value
                //document.getElementById("<%=btnLoadViewSI.ClientID%>").click();
                $find(ModalViewSIs).show();
                //$find(ModalProgress).show();
                return false;
            }
      }

        function clickVerifyUnitPrice() {
          
              document.getElementById("<%=ibtnVerifyUnitPrice.ClientID%>").click();
        }


        function IsUnitPriceValid() {
            if (document.getElementById("<%=txtUnitPrice.ClientID%>").value <= 0) {
                    SetMessage("Unit Price should be greater than zero(0).", "warning")
                    return false
                }
        }

      function IsViewDMCMValid() {
             var vDMCMTransNo = document.getElementById('<%=txtDMCMTransNo.ClientID%>').value;
             var vSINo = document.getElementById('<%=txtViewDMCMBySINo.ClientID%>').value;
             var vDateFr = document.getElementById('<%=txtViewDMCMFromDate.ClientID%>').value;
             var vDateTo = document.getElementById('<%=txtViewDMCMToDate.ClientID%>').value;

          if (vDMCMTransNo == "" && vDMCMTransNo == "") {
                 if (vDateFr == "" || vDateTo == "") {
                     SetMessage("Please enter dates.", "info");
                     return false;
                 }
             }
        }

      function CloseModal() {
          $find(ModalViewDMCMs).hide();
          $find(ModalViewSIs).hide();
          return false;
      }

      function CancelReason() {
                   <%=Page.ClientScript.GetPostBackEventReference(btnConfirmYes, Nothing)%>;
           }

      function SetMessage(message, icon) {
          document.getElementById('<%=lblMessage.ClientID%>').innerHTML = message;
            document.getElementById('<%=imgMessage.ClientID%>').src = "Images/icons/" + icon + ".png";
            $find(ModalMessage).show();
        }

           function SetConfirmation(message, caller) {
            document.getElementById('<%=lblConfirm.ClientID%>').innerHTML = message;
               document.getElementById('<%=hdnConfirmCaller.ClientID%>').value = caller;
               $find(ModalConfirm).show();
           }

           function IsOkOnly() {
               $find(ModalMessage).hide();
               return false
           }
           
           function IsSaveValid() {
              
               if ($('#<%=txtInvoiceNumber.ClientID%>').val().trim() == "") {
                   SetMessage("Please input SI Number.", "warning");
                   return false;
               }

               if ($('#<%=txtDMCMRemarks.ClientID%>').val().trim() == "") {
                   SetMessage("Please input Remarks.", "warning");
                   return false;
               }

                if ($('#<%=hdnIsUnitPriceLocked.ClientID%>').val().toLowerCase() === "false") {
                    SetMessage("Please verify Unit Price.", "warning");
                    return false
                }

               if ($('#<%= ddlApprover.ClientID %>').val().trim() === "") {
                   SetMessage("Please select approver.", "warning");
                   return false;
               }

            return ConfirmSave();
        }
        
        function ConfirmSave() {
            if ($('#<%=hdnIsUnitPriceLocked.ClientID%>').val() == "Save" || $('#<%=hdnIsUnitPriceLocked.ClientID%>').val() == "Update") {
                SetConfirmation("Are you sure you want to save this AR?", "SAVE");
                return false;
            }
        }
      
      
  </script>
<asp:UpdatePanel ID="upPaymentDebitCreditMemo" runat="server" RenderMode="Inline" UpdateMode="Conditional">
    <ContentTemplate>
         <div id="content">
             <div id="content-header-paymentdebitcreditmemo" class="content-header"></div>
                 <div id="content-body">

                           <!-- PAYMENT DETAILS -->
                    <asp:Panel ID="pnlPaymentDetails" runat="server" CssClass="content-body-panel">
                        <div class="content-body-panel-header">Debit Credit Memo Details</div>
                        <div class="content-body-panel-detail">
                            <table width="100%" border="0" cellpadding="0" cellspacing="0">
                                  <tr>
                                    <td class="content-body-panel-td1 lblBold11">Transaction ID</td>
                                    <td class="content-body-panel-td2">
                                        <asp:TextBox ID="txtDMCMTransNo" runat="server" CssClass="txtReadOnlyShort" ReadOnly="true" TabIndex="-1"></asp:TextBox>
                                        <asp:ImageButton ID="ibtnViewDMCMs" runat="server" ImageUrl="~/Images/icons/view.png" CssClass="ibtn ibtnView" CausesValidation="false" ToolTip="View DMCMs" OnClientClick="return ViewDMCMs();"/>
                                    </td>
                                    <td class="content-body-panel-td3 lblBold11">DMCM Date</td>
                                    <td class="content-body-panel-td4">
                                        <asp:TextBox ID="txtDMCMDate" runat="server" CssClass="txtReadOnlyShort" ReadOnly="true" TabIndex="-1"></asp:TextBox>
                                    </td>
                                </tr>
                                 <tr>
                                    <td class="content-body-panel-td1 lblBold11">DMCM Number</td>
                                    <td class="content-body-panel-td2">
                                        <asp:TextBox ID="txtDMCMNumber" runat="server" CssClass="txtReadOnlyShort" ReadOnly="true" TabIndex="-1"></asp:TextBox>
                                    </td>
                                    <td class="content-body-panel-td3 lblBold11"></td>
                                    <td class="content-body-panel-td4">
                                        
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <asp:Panel id="pnlPaymentDetails1" runat="server">
                            <div class="content-body-panel-detail">
                                <table width="100%" border="0" cellpadding="0" cellspacing="0">
                                     
