                                                        <asp:FilteredTextBoxExtender ID="fteVATAmount" runat="server"  TargetControlID="txtVATAmount" FilterType="Custom, Numbers" ValidChars=".,"></asp:FilteredTextBoxExtender>

                                                    </td>
