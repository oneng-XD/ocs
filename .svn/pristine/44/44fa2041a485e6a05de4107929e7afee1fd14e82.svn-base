#Region "Constructor"

        Sub New()

        End Sub

        Sub New(ByVal pId As Long, ByVal pOPRNmbr As Long, ByVal pTrnxCode As Long, ByVal pActType As String,
                ByVal pTrnxDesc As String, ByVal pDueDate As Date, ByVal pAmount As Decimal,
                ByVal pLineNmbr As Long, ByVal pStatusId As Integer, ByVal pPostBy As Long, ByVal pPostDate As Date,
                ByVal pLastUpdateBy As Long, ByVal pLastUpdate As Date)
            Id = pId
            OPRNmbr = pOPRNmbr
            TrnxCode = pTrnxCode
            ActType = pActType
            TrnxDesc = pTrnxDesc
            DueDate = pDueDate
            Amount = pAmount
            LineNmbr = pLineNmbr
            StatusId = pStatusId
            PostBy = pPostBy
            PostDate = pPostDate
            LastUpdateBy = pLastUpdateBy
            LastUpdate = pLastUpdate
