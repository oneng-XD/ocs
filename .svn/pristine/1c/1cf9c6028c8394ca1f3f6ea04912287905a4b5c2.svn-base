        Get
            Return cDataType.fDecimal.IfNull(hdnCommissionAmount.Value)
        End Get
        Set(value As Decimal)
            hdnCommissionAmount.Value = value

            If Val(value) = 0 Then
                WithCommission = False
            Else
                WithCommission = True
            End If
        End Set
