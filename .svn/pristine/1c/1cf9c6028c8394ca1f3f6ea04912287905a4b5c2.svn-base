        Get
            Return IIf(ddlPolicyType.SelectedValue = "GRP", True, False)
        End Get
        Set(value As Boolean)
            If value Then
                ddlPolicyType.SelectedValue = "GRP"
            Else
                ddlPolicyType.SelectedValue = String.Empty
            End If
        End Set
    End Property

