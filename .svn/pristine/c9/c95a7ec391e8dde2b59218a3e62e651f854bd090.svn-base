#Region "Processing"
        Private Sub CheckSourceSite(ByVal sender As Object, ByVal e As EventArgs)

            Try

                With vwPaymentAckReceipt
                    .IsSuccessful = False

                    If .SourceSite = String.Empty Then
                        Call SetMessage("Please select a Source Site.", eSystemMessage.Warning, True)
                        Return
                    End If

                    .IsSuccessful = True
                End With

            Catch ex As Exception
                Call SetMessage(String.Concat("A runtime error has occurred.<br /><br />", "Error CheckSourceSite.<br /><br />", ex.Message), eSystemMessage.Critical, True)
            End Try

        End Sub

        Private Sub LoadNewAckReceipt(ByVal sender As Object, ByVal e As EventArgs)

            Try
                Dim objBLL As New bllStaging.BAckReceipt
                With vwPaymentAckReceipt
                    .IsSuccessful = False

                    objBLL.LoadNewAckReceipt(vwPaymentAckReceipt.SiteCode, vwPaymentAckReceipt.UserID)

                    .IsSuccessful = True
                    .ReservedDocNo = objBLL.AckReceiptNumber
                    .AckReceiptNumber = 0
                    .ARDate = Now.ToShortDateString
                End With

            Catch ex As ArgumentException
                Call SetMessage(String.Concat("New Document is not Allowed!<br /><br />", ex.Message), eSystemMessage.Information, True)
            Catch ex As Exception
                Call SetMessage(String.Concat("A runtime error has occurred.<br /><br />", "Error LoadNewAckReceipt.<br /><br />", ex.Message), eSystemMessage.Critical, True)
            End Try

        End Sub

        Private Sub LoadViewAR(ByVal sender As Object, ByVal e As EventArgs)
            Try
                Dim objBLL As New bllStaging.BAckReceipt
                Dim dtLocal As New DataTable

                With vwPaymentAckReceipt
                    If IsValidLoadViewAR() Then
                        If .ViewARNumber > 0 Then
                            dtLocal = objBLL.LoadViewAR(.SiteCode, .ViewARNumber, 0)
                        ElseIf .ViewARBySINo > 0 Then
                            dtLocal = objBLL.LoadViewAR(.SiteCode, .ViewARBySINo, 1)
                        Else
                            dtLocal = objBLL.LoadViewAR(.SiteCode, .ViewARFrom, .ViewARTo)
                        End If

                        If dtLocal.Rows.Count = 0 Then
                            Call SetMessage(String.Concat("View Ack Receipts.<br /><br />", "No AR found!"), eSystemMessage.Information, True)

                        End If

                        .dtViewAR = dtLocal
                    End If
                End With

            Catch ex As Exception
                Call SetMessage(String.Concat("A runtime error has occurred.<br /><br />", "Error LoadViewAR.<br /><br />", ex.Message), eSystemMessage.Critical, True)
            End Try
        End Sub

        Private Sub LoadViewSI(ByVal sender As Object, ByVal e As EventArgs)
            Try
                Dim objBLL As New bllReference.BSalesInvoice
                Dim dtLocal As New DataTable

                With vwPaymentAckReceipt
                    If IsValidLoadViewSI() Then
                        If .SourceType <> "SSO" Then
                            If .ViewSINumber > 0 Then
                                dtLocal = objBLL.LoadViewDoc(.SiteCode, .ViewSINumber, 2)
                            Else
                                dtLocal = objBLL.LoadViewDoc(.SiteCode, 2, .ViewSIFrom, .ViewSITo)
                            End If
                        Else
                            If .ViewSINumber > 0 Then
                                dtLocal = objBLL.LoadViewDoc(CLng(.SourceSite), .ViewSINumber, 0)
                            ElseIf .ViewSIReferenceNumber <> String.Empty Then
                                dtLocal = objBLL.LoadViewDoc(CLng(.SourceSite), .ViewSIReferenceNumber)
                            Else
                                dtLocal = objBLL.LoadViewDoc(CLng(.SourceSite), 0, .ViewSIFrom, .ViewSITo)
                            End If
                        End If

                        If dtLocal.Rows.Count = 0 Then
                            Call SetMessage(String.Concat("View Sales Invoices.<br /><br />", "No SI found!"), eSystemMessage.Information, True)

                        End If

                        .dtViewSI = dtLocal
                    End If
                End With

            Catch ex As Exception
                Call SetMessage(String.Concat("A runtime error has occurred.<br /><br />", "Error LoadViewSI.<br /><br />", ex.Message), eSystemMessage.Critical, True)
            End Try
        End Sub

        Private Sub ProcessAckReceipt(ByVal sender As Object, ByVal e As EventArgs)
            'Objects
            Dim objAckReceipt As New bllStaging.BAckReceipt
            Dim objARPayDetails As New bllStaging.BARPayDetails
            'Lists
            Dim lstARPayDetails As New List(Of bllStaging.BARPayDetails)
            Dim lstIdARPayDetails As New List(Of Long)

            Dim lstForDeletion As New List(Of Object)
            Dim mDocSaveState As String = String.Empty

            Try


                With vwPaymentAckReceipt
                    .IsSuccessful = False

                    If IsValidPaymentAckReceipt() Then
                        mDocSaveState = .DocSaveState

                        Select Case mDocSaveState
                            Case eReference.DocSaveState.Edit, eReference.DocSaveState.Cancel, eReference.DocSaveState.Print
                                Dim dtARPayDetails = objARPayDetails.GetDt(.AckReceiptNumber, .UserID)

                                For Each dr As DataRow In dtARPayDetails.Rows
                                    If mDocSaveState = eReference.DocSaveState.Edit Or mDocSaveState = eReference.DocSaveState.Print Then
                                        lstIdARPayDetails.Add(dr.Item("id"))
                                        lstForDeletion.Add(New bllStaging.BARPayDetails() With {.ARPayDetailsID = dr.Item("id"), .ARNo = dr.Item("ar_no"), .Status = dr.Item("status"), .LastUpdateBy = vwPaymentAckReceipt.UserID})
                                    Else
                                        lstARPayDetails.Add(New bllStaging.BARPayDetails() With {.ARPayDetailsID = dr.Item("id"), .ARNo = dr.Item("ar_no"), .Status = dr.Item("status"), .LastUpdateBy = vwPaymentAckReceipt.UserID})
                                    End If
                                Next
                        End Select

                        Select Case mDocSaveState

                            Case eReference.DocSaveState.AddNew, eReference.DocSaveState.Edit, eReference.DocSaveState.Print, eReference.DocSaveState.Cancel
                                If .DocSaveState = eReference.DocSaveState.Print AndAlso .ARPrintStatus = "POSTED" Then
                                    .IsSuccessful = True
                                    SetMessage(String.Concat("<strong><h2>REMINDER:</h2></strong><br />Please print receipt using OCS - Printer!"), eSystemMessage.Information, True)
                                    Exit Sub
                                End If

                                If .DocSaveState = eReference.DocSaveState.Cancel Then
                                    .AckReceiptRemarks = String.Concat(.CancellationReason, ";", Chr(13), .AckReceiptRemarks)
                                    .CancellationReason = String.Empty
                                End If

                                If .CashTotalAmount > 0 Then
                                    lstARPayDetails.Clear()
                                    lstARPayDetails.Add(New bllStaging.BARPayDetails(GetIdFromList(lstIdARPayDetails, lstARPayDetails.Count), .AckReceiptNumber, eReference.PayTypeCSH, .CashTotalAmount, "", 0, "", "", "", "", "", .ARDate, "", "", "", 0, 0, "READY", .UserID))
                                End If
                                For Each item In .lstPaymentTypeDetails
                                    Select Case item.PaymentType
                                        Case eReference.PayTypeCHQ
                                            lstARPayDetails.Add(New bllStaging.BARPayDetails(GetIdFromList(lstIdARPayDetails, lstARPayDetails.Count), .AckReceiptNumber, item.PaymentType, item.Amount, item.CheckNumber, 0, item.Bank, item.Branch, "", "", "", .ARDate, "", "", "", 0, 0, "READY", .UserID))
                                        Case eReference.PayTypeCCA
                                            lstARPayDetails.Add(New bllStaging.BARPayDetails(GetIdFromList(lstIdARPayDetails, lstARPayDetails.Count), .AckReceiptNumber, item.PaymentType, item.Amount, item.ApprovalCode, item.BatchNumber, "", "", "", item.TerminalUse, item.MerchantID, item.SwipeDate, item.CardType, item.CardNumber, item.Remarks, 0, 0, "READY", .UserID))
                                        Case eReference.PayTypeDCA
                                            lstARPayDetails.Add(New bllStaging.BARPayDetails(GetIdFromList(lstIdARPayDetails, lstARPayDetails.Count), .AckReceiptNumber, item.PaymentType, item.Amount, item.ApprovalCode, item.BatchNumber, item.Bank, item.Branch, item.Network, item.TerminalUse, item.MerchantID, item.SwipeDate, item.CASA, item.AccountNumber, item.Remarks, 0, 0, "READY", .UserID))
                                        Case eReference.PayTypeECP
                                            lstARPayDetails.Add(New bllStaging.BARPayDetails(GetIdFromList(lstIdARPayDetails, lstARPayDetails.Count), .AckReceiptNumber, item.PaymentChannel, item.Amount, item.ReferenceID, 0, "", "", "", "", "", .ARDate, "", "", item.Remarks, item.ServiceFeeRate, 0, "READY", .UserID))
                                    End Select
                                Next

                                objAckReceipt = New bllStaging.BAckReceipt(.AckReceiptID, .ReferenceNo, .PayorName, .PayorAddress, .PayorTIN,
                                                                           .InsuredClientName, .PolicyNumber, .CoveragePeriodFrom, .CoveragePeriodTo, .InvoiceCurrency,
                                                                           .PayCurrency, .GrossAmount, .TotalSales, .WitholdingTax, .NetOfWitholdingTax,
                                                                           .Discount, .DiscountIdNo, .AckReceiptRemarks, .AckReceiptOtherInfo, .InvoiceNumber,
                                                                           .AckReceiptNumber, .InvoiceDate, .ARDate, .ARPrintStatus, .UserID,
                                                                           .SiteCode, .Particulars, .PaymentTerm, .NextDueDate, .AgentName,
                                                                           .AgentCode, .CommissionAmount)

                        End Select

                        objPaymentAckReceipt = New bllPayment.BPaymentAckReceipt

                        With objPaymentAckReceipt
                            .SiteCode = vwPaymentAckReceipt.SiteCode
                            .UserID = vwPaymentAckReceipt.UserID
                            .AckReceipt = objAckReceipt
                            .ARPayDetails = lstARPayDetails
                            .lstForDeletion = lstForDeletion

                            Select Case mDocSaveState
                                Case eReference.DocSaveState.AddNew, eReference.DocSaveState.Edit
                                    .IsSuccessful = True
                                    .ProcessPaymentAckReceipt()
                                    vwPaymentAckReceipt.AckReceiptNumber = .ReservedDocNo
                                Case eReference.DocSaveState.Print
                                    .IsSuccessful = True
                                    .PrintPaymentAckReceipt()

                                Case eReference.DocSaveState.Cancel
                                    .IsSuccessful = True
                                    .CancelPaymentAckReceipt()
                            End Select
                        End With
                        .IsSuccessful = objPaymentAckReceipt.IsSuccessful
                    End If
                End With
                If vwPaymentAckReceipt.IsSuccessful Then
                    If mDocSaveState = eReference.DocSaveState.Print Then
                        SetMessage(String.Concat("<strong><h2>REMINDER:</h2></strong><br />Please print receipt using OCS - Printer!"), eSystemMessage.Information, True)
                    Else
                        Call SetMessage(String.Concat("Ack Receipt.<br /><br />", "Transaction Successful!<br /><br />"), eSystemMessage.Information, True)
                    End If
                End If

            Catch ex As Exception
                Call SetMessage(String.Concat("An Error has occurred.<br /><br />", ex.Message), eSystemMessage.Information, True)
            End Try

        End Sub

        Private Sub ConfirmCancel(ByVal sender As Object, ByVal e As EventArgs)
            Try
                With vwConfirmMsg
                    .ConfirmCaller = "CANCEL"
                    .Message = String.Concat("Are you sure you want to cancel Ack. Receipt#", vwPaymentAckReceipt.InvoiceNumber, "?")
                    .isMessage = True
                End With
            Catch ex As Exception
                Call SetMessage(String.Concat("A runtime error has occurred.<br /><br />", "Error ConfirmCancel.<br /><br />", ex.Message), eSystemMessage.Critical, True)
            End Try
        End Sub

        Private Sub ConfirmSave(ByVal sender As Object, ByVal e As EventArgs)
            Try
                With vwConfirmMsg
                    .ConfirmCaller = "SAVE"
                    .Message = "Are you sure you want to save this Ack. Receipt?"
                    .isMessage = True
                End With
            Catch ex As Exception
                Call SetMessage(String.Concat("A runtime error has occurred.<br /><br />", "Error ConfirmSave.<br /><br />", ex.Message), eSystemMessage.Critical, True)
            End Try
        End Sub

        Private Sub ConfirmPrint(ByVal sender As Object, ByVal e As EventArgs)
            Try
                With vwConfirmMsg
                    .ConfirmCaller = "PRINT"
                    .Message = String.Concat("Are you sure you want to print Ack. Receipt#", vwPaymentAckReceipt.AckReceiptNumber, "?")
                    .isMessage = True
                End With
            Catch ex As Exception
                Call SetMessage(String.Concat("A runtime error has occurred.<br /><br />", "Error ConfirmPrint.<br /><br />", ex.Message), eSystemMessage.Critical, True)
            End Try
        End Sub

        Private Sub LoadSalesInvoice(ByVal sender As Object, ByVal e As EventArgs)

            Dim objBLL As New bllReference.BSalesInvoice
            Dim lstLocal As New List(Of cSIDetails)

            Try
                If IsValidInvoiceNumber() Then
                    With vwPaymentAckReceipt
                        .IsInvoiceNoExisting = False
                        objBLL.SearchSalesInvoiceByNo(.InvoiceNumber)

                        .IsInvoiceNoExisting = objBLL.IsRecordExist
                        If .IsInvoiceNoExisting Then
                            .IsSourceSiteLocked = True
                            If objBLL.SIPrintStatus = "CANCELLED" Then
                                .IsInvoiceNoExisting = False
                                Throw New ArgumentException("Invoice No : " & objBLL.InvoiceNumber)
                            End If

                            .ReferenceNo = objBLL.ReferenceNo
                            .PayorName = objBLL.PayorName
                            .PayorAddress = objBLL.PayorAddress
                            .PayorTIN = objBLL.PayorTIN
                            .InsuredClientName = objBLL.InsuredClientName
                            .PolicyNumber = objBLL.PolicyNumber
                            .CoveragePeriodFrom = objBLL.CoveragePeriodFrom
                            .CoveragePeriodTo = objBLL.CoveragePeriodTo
                            .InvoiceCurrency = objBLL.InvoiceCurrency
                            .InvoiceAmount = objBLL.InvoiceAmount
                            '.TotalSales = objBLL.TotalSales
                            '.WitholdingTax = objBLL.WitholdingTax
                            '.NetOfWitholdingTax = objBLL.NetOfWitholdingTax
                            '.Discount = objBLL.Discount
                            '.DiscountIdNo = objBLL.DiscountIdNo
                            .PaymentTerm = objBLL.PaymentTerm
                            .NextDueDate = objBLL.NextDueDate
                            .AgentName = objBLL.AgentName
                            .AgentCode = objBLL.AgentCode
                            .InvoiceNumber = objBLL.InvoiceNumber
                            .InvoiceDate = objBLL.InvoiceDate
                            .AckReceiptRemarks = objBLL.InvoiceRemarks
                            .AckReceiptOtherInfo = objBLL.InvoiceOtherInfo
                            .SIPrintStatus = objBLL.SIPrintStatus
                            For Each dr As DataRow In objBLL.dtSIDetails.Rows
                                lstLocal.Add(New cSIDetails(dr))
                            Next
                            .lstSIDetails = lstLocal
                        Else
                            .IsInvoiceNoExisting = False
                            Call ClearScreenInfo(sender, e)
                            Call SetMessage("No Record(s) Found.", eSystemMessage.Information, True)
                        End If
                    End With
                End If
            Catch ex As ArgumentException
                Call SetMessage(String.Concat("Invoice is Cancelled!.<br /><br />", ex.Message), eSystemMessage.Information, True)
            Catch ex As Exception
                Call SetMessage(String.Concat("A runtime error has occurred.<br /><br />", "Error LoadSalesInvoice.<br /><br />", ex.Message), eSystemMessage.Critical, True)
            End Try
        End Sub

        Private Sub LoadAckReceipt(ByVal sender As Object, ByVal e As EventArgs)

            Dim objBLL As New bllStaging.BAckReceipt
            Dim lstLocalSI As New List(Of cSIDetails)
            Dim lstLocalARPay As New List(Of cPaymentType)

            Try

                If IsValidAckReceiptNumber() Then
                    With vwPaymentAckReceipt
                        .IsARNoExisting = False
                        objBLL.LoadAckReceipt(.AckReceiptNumber, .UserID)
                        .IsARNoExisting = objBLL.IsRecordExist

                        If .IsARNoExisting Then
                            'AR Details
                            .AckReceiptID = objBLL.AckReceiptID
                            .AckReceiptNumber = objBLL.AckReceiptNumber
                            .ARDate = objBLL.ARDate
                            .IsSourceSiteLocked = True
                            .AckReceiptRemarks = objBLL.AckReceiptRemarks
                            .AckReceiptOtherInfo = objBLL.AckReceiptOtherInfo
                            .IsGrossAmountLocked = True
                            'Sales Details
                            .IsWTaxLocked = True
                            .IsDiscountLocked = True
                            .IsCommLocked = True
                            .TotalSales = objBLL.TotalSales
                            .WitholdingTax = objBLL.WitholdingTax
                            .NetOfWitholdingTax = objBLL.NetOfWitholdingTax
                            .Discount = objBLL.Discount
                            .DiscountIdNo = objBLL.DiscountIdNo
                            .CommissionAmount = objBLL.CommissionAmount
                            '----------
                            .ARPrintStatus = objBLL.ARPrintStatus
                            Select Case .ARPrintStatus
                                Case "CANCELLED"
                                    .DocSaveState = eReference.DocSaveState.Cancel
                                Case "READY"
                                    .DocSaveState = eReference.DocSaveState.ViewEdit
                                Case "PRINTED"
                                    .DocSaveState = eReference.DocSaveState.Print
                                Case Else
                                    .DocSaveState = eReference.DocSaveState.ViewNoEdit
                            End Select

                            'SI Details
                            .InvoiceNumber = objBLL.InvoiceNumber
                            .InvoiceDate = objBLL.InvoiceDate
                            .PolicyNumber = objBLL.PolicyNumber
                            .ReferenceNo = objBLL.BillReferenceNo
                            .InvoiceAmount = objBLL.PayAmount
                            .InvoiceCurrency = objBLL.InvoiceCurrency
                            .PayorName = objBLL.PayorName
                            .PayorAddress = objBLL.PayorAddress
                            .PayorTIN = objBLL.PayorTIN
                            .InsuredClientName = objBLL.InsuredClientName
                            .CoveragePeriodFrom = objBLL.InvoiceCovFrom
                            .CoveragePeriodTo = objBLL.InvoiceCovTo
                            .AgentName = objBLL.AgentName
                            .AgentCode = objBLL.AgentCode
                            .PaymentTerm = objBLL.PaymentTerm
                            .NextDueDate = objBLL.NextDueDate
                            .Particulars = objBLL.Particulars
                            For Each dr As DataRow In objBLL.dtSIDetails.Rows
                                lstLocalSI.Add(New cSIDetails(dr))
                            Next
                            .lstSIDetails = lstLocalSI

                            If objBLL.dtARPayDetails.Rows.Count > 0 Then .PaymentTypeTag = True
                            For Each dr As DataRow In objBLL.dtARPayDetails.Rows
                                If dr.Item("status") = .ARPrintStatus Then
                                    lstLocalARPay.Add(New cPaymentType(dr, dr.Item("payment_type"), 1))
                                    AddToTotalAmount(dr.Item("payment_type"), cDataType.fDecimal.IfNull(dr.Item("amount")))
                                End If
                            Next
                            .lstPaymentTypeDetails = lstLocalARPay
                            .GrossAmount = objBLL.PayAmount
                        Else
                            .IsARNoExisting = False
                            Call ClearScreenInfo(sender, e)
                            Call SetMessage("No Record(s) Found.", eSystemMessage.Information, True)
                        End If
                    End With
                End If
            Catch ex As ArgumentException
                Call SetMessage(String.Concat("Reference No Already Used!.<br /><br />", ex.Message), eSystemMessage.Information, True)
            Catch ex As Exception
                Call SetMessage(String.Concat("A runtime error has occurred.<br /><br />", "Error LoadAckReceipt.<br /><br />", ex.Message), eSystemMessage.Critical, True)
            End Try
        End Sub

        Private Sub AddToTotalAmount(ByVal pPayType As String, ByVal pAmount As Decimal)
            Try
                With vwPaymentAckReceipt
                    Select Case pPayType
                        Case eReference.PayTypeCSH
                            .CashTotalAmount += pAmount
                        Case eReference.PayTypeCHQ
                            .CheckTotalAmount += pAmount
                        Case eReference.PayTypeCCA
                            .CreditCardTotalAmount += pAmount
                        Case eReference.PayTypeDCA
                            .DebitCardTotalAmount += pAmount
                        Case Else
                            .ECashPaymentTotalAmount += pAmount
                    End Select
                End With
            Catch ex As Exception
                Throw New Exception(String.Concat("AddToTotalAmount : ", ex.Message))
            End Try

        End Sub

        Private Sub SetMessage(ByVal pMessage As String, ByVal pMessageType As String, ByVal pIsMessage As Boolean)

            Try
                With vwSysMsg
                    .Message = pMessage
                    .MessageType = pMessageType
                    .isMessage = pIsMessage
                End With
            Catch ex As Exception
                Throw
            End Try

        End Sub

        Private Sub GetConfirmation(ByVal pMessage As String, ByVal pIsMessage As Boolean)

            Try
                With vwConfirmMsg
                    .ClickedState = False
                    .Message = pMessage
                    .isMessage = pIsMessage
                End With
            Catch ex As Exception
                Throw
            End Try

        End Sub
        ' -------------------------------------------------------------------------------
#End Region




