#Region "Data Retrieval"

        Public Function GetOPRChkPyDt(ByVal pDocNumber As Long, ByVal pUserId As Long) As DataTable
            Try
                Dim objDal As New dalWorking.DSiteOPRChkPy
                Dim dtLocal As DataTable

                dtLocal = objDal.GetSiteOPRChkPy(pDocNumber, pUserId)

                Return dtLocal
            Catch ex As Exception
                Throw
            End Try
        End Function

        Public Function GetCheckTagging(ByVal pSiteCode As Long, Optional ByVal pFromDate As Date = #1/1/1900#, Optional ByVal pToDate As Date = #1/1/1900#, Optional ByVal pReceiptNo As Long = 0, Optional ByVal pCheckNo As Long = 0) As DataTable
            Try
                Dim objDal As New dalWorking.DSiteOPRChkPy
                Dim dtLocal As DataTable

                dtLocal = objDal.GetCheckTagging(pSiteCode, pReceiptNo, pCheckNo, pFromDate, pToDate)

                Return dtLocal
            Catch ex As Exception
                Throw
            End Try
        End Function

        Public Function GetForDeposit(ByVal pSiteCode As Long, ByVal pReceiptNo As Long, ByVal pCheckNo As Long, ByVal pFromDate As Date, ByVal pToDate As Date) As DataTable
            Try
                Dim objDal As New dalWorking.DSiteOPRChkPy
                Dim dtLocal As DataTable

                dtLocal = objDal.GetCheckTagging(pSiteCode, pReceiptNo, pCheckNo, pFromDate, pToDate)

                Dim dtFiltered = From c In dtLocal.AsEnumerable
                                 Where CDate(c.Item("clearing_date")) = #1/1/1900#
                                 Select c

                If dtFiltered.Any Then
                    dtLocal = dtFiltered.CopyToDataTable
                Else
                    dtLocal = New DataTable
                End If

                Return dtLocal
            Catch ex As Exception
                Throw
            End Try
        End Function

        Public Function GetForClearing(ByVal pSiteCode As Long, ByVal pReceiptNo As Long, ByVal pCheckNo As Long, ByVal pFromDate As Date, ByVal pToDate As Date) As DataTable
            Try
                Dim objDal As New dalWorking.DSiteOPRChkPy
                Dim dtLocal As DataTable

                dtLocal = objDal.GetCheckTagging(pSiteCode, pReceiptNo, pCheckNo, pFromDate, pToDate)

                Dim dtFiltered = From c In dtLocal.AsEnumerable
                                 Where CDate(c.Item("deposit_date")) <> #1/1/1900#
                                 Select c

                If dtFiltered.Any Then
                    dtLocal = dtFiltered.CopyToDataTable
                Else
                    dtLocal = New DataTable
                End If

                Return dtLocal
            Catch ex As Exception
                Throw
            End Try
        End Function

        Public Function GetForReDeposit(ByVal pSiteCode As Long, ByVal pReceiptNo As Long, ByVal pCheckNo As Long, ByVal pFromDate As Date, ByVal pToDate As Date) As DataTable
            Try
                Dim objDal As New dalWorking.DSiteOPRChkPy
                Dim dtLocal As DataTable

                dtLocal = objDal.GetCheckTagging(pSiteCode, pReceiptNo, pCheckNo, pFromDate, pToDate)

                Dim dtFiltered = From c In dtLocal.AsEnumerable
                                 Where CDate(c.Item("clearing_date")) <> #1/1/1900# _
                                 And CInt(c.Item("code")) = 1
                                 Select c

                If dtFiltered.Any Then
                    dtLocal = dtFiltered.CopyToDataTable
                Else
                    dtLocal = New DataTable
                End If

                Return dtLocal
            Catch ex As Exception
                Throw
            End Try
        End Function

#End Region

#Region "Transactions"

        Public Function Alter(ByVal pAction As String, ByRef pConn As Object, ByRef pTrans As Object) As Long

            Try
                Dim objDAL As New dalWorking.DSiteOPRChkPy
                objDAL.AlterSiteOPRChkPy(Me, pAction, pConn, pTrans)
                Return objDAL.Reference
            Catch ex As Exception
                Throw
            End Try

        End Function

#End Region

